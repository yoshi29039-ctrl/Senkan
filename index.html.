const canvas=document.getElementById('c');
const gl=canvas.getContext('webgl',{antialias:true,alpha:false});
if(!gl) throw new Error('WebGL unavailable');

function compile(type,src){
  const s=gl.createShader(type);
  gl.shaderSource(s,src);
  gl.compileShader(s);
  if(!gl.getShaderParameter(s,gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
  return s;
}
function program(vs,fs){
  const p=gl.createProgram();
  gl.attachShader(p,compile(gl.VERTEX_SHADER,vs));
  gl.attachShader(p,compile(gl.FRAGMENT_SHADER,fs));
  gl.linkProgram(p);
  if(!gl.getProgramParameter(p,gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p));
  return p;
}

const commonVS=`
attribute vec3 aPos;
attribute vec3 aNor;
uniform mat4 uMVP;
uniform float uExpand;
varying vec3 vN;
void main(){
  vec3 p=aPos + aNor*uExpand;
  vN=aNor;
  gl_Position=uMVP*vec4(p,1.0);
}`;

const toonFS=`
precision mediump float;
varying vec3 vN;
void main(){
  vec3 N=normalize(vN);
  vec3 L=normalize(vec3(-0.45,-0.55,1.0));
  float d=max(dot(N,L),0.0);
  float band;
  if(d>0.78) band=1.00;
  else if(d>0.48) band=0.72;
  else if(d>0.22) band=0.48;
  else band=0.30;

  vec3 base=vec3(0.22,0.20,0.43);        // blue-purple hull
  vec3 shadow=vec3(0.10,0.09,0.24);
  vec3 col=mix(shadow,base,band);

  float rim=1.0-max(dot(N,normalize(vec3(0.2,-0.5,0.8))),0.0);
  if(rim>0.78) col += vec3(0.06,0.07,0.14);

  gl_FragColor=vec4(col,1.0);
}`;

const outlineFS=`
precision mediump float;
void main(){
  gl_FragColor=vec4(0.015,0.018,0.035,1.0);
}`;

const toonProg=program(commonVS,toonFS);
const outlineProg=program(commonVS,outlineFS);

function setupBuffers(prog){
  gl.useProgram(prog);

  const posBuf=gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER,posBuf);
  gl.bufferData(gl.ARRAY_BUFFER,POS,gl.STATIC_DRAW);
  const aPos=gl.getAttribLocation(prog,'aPos');
  gl.enableVertexAttribArray(aPos);
  gl.vertexAttribPointer(aPos,3,gl.FLOAT,false,0,0);

  const norBuf=gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER,norBuf);
  gl.bufferData(gl.ARRAY_BUFFER,NOR,gl.STATIC_DRAW);
  const aNor=gl.getAttribLocation(prog,'aNor');
  gl.enableVertexAttribArray(aNor);
  gl.vertexAttribPointer(aNor,3,gl.FLOAT,false,0,0);

  return {
    uMVP:gl.getUniformLocation(prog,'uMVP'),
    uExpand:gl.getUniformLocation(prog,'uExpand'),
    posBuf,norBuf,aPos,aNor
  };
}

const toonLoc=setupBuffers(toonProg);
const outLoc=setupBuffers(outlineProg);

function bindAttribs(prog,loc){
  gl.useProgram(prog);
  gl.bindBuffer(gl.ARRAY_BUFFER,loc.posBuf);
  gl.enableVertexAttribArray(loc.aPos);
  gl.vertexAttribPointer(loc.aPos,3,gl.FLOAT,false,0,0);
  gl.bindBuffer(gl.ARRAY_BUFFER,loc.norBuf);
  gl.enableVertexAttribArray(loc.aNor);
  gl.vertexAttribPointer(loc.aNor,3,gl.FLOAT,false,0,0);
}

function perspective(fovy,aspect,near,far){
 const f=1/Math.tan(fovy/2),nf=1/(near-far);
 return [f/aspect,0,0,0, 0,f,0,0, 0,0,(far+near)*nf,-1, 0,0,(2*far*near)*nf,0];
}
function mul(a,b){
 let r=new Array(16).fill(0);
 for(let c=0;c<4;c++)for(let rr=0;rr<4;rr++)for(let k=0;k<4;k++)r[c*4+rr]+=a[k*4+rr]*b[c*4+k];
 return r;
}
function lookAt(e,c,u){
 let zx=e[0]-c[0],zy=e[1]-c[1],zz=e[2]-c[2]; let zl=Math.hypot(zx,zy,zz);zx/=zl;zy/=zl;zz/=zl;
 let xx=u[1]*zz-u[2]*zy,xy=u[2]*zx-u[0]*zz,xz=u[0]*zy-u[1]*zx;let xl=Math.hypot(xx,xy,xz);xx/=xl;xy/=xl;xz/=xl;
 let yx=zy*xz-zz*xy,yy=zz*xx-zx*xz,yz=zx*xy-zy*xx;
 return [xx,yx,zx,0, xy,yy,zy,0, xz,yz,zz,0, -(xx*e[0]+xy*e[1]+xz*e[2]),-(yx*e[0]+yy*e[1]+yz*e[2]),-(zx*e[0]+zy*e[1]+zz*e[2]),1];
}

let yaw=-0.65,pitch=0.42,dist=2100;
function resetView(){yaw=-0.65;pitch=0.42;dist=2100}
function setView(v){
 if(v==='iso'){yaw=-0.65;pitch=0.42;dist=2100}
 if(v==='front'){yaw=0;pitch=0;dist=2200}
 if(v==='side'){yaw=-Math.PI/2;pitch=0;dist=2200}
 if(v==='top'){yaw=-Math.PI/2;pitch=Math.PI/2-0.02;dist=2300}
}

let dragging=false,lastX=0,lastY=0,lastPinch=0;
canvas.addEventListener('pointerdown',e=>{dragging=true;lastX=e.clientX;lastY=e.clientY;canvas.setPointerCapture(e.pointerId)});
canvas.addEventListener('pointermove',e=>{if(!dragging)return;let dx=e.clientX-lastX,dy=e.clientY-lastY;lastX=e.clientX;lastY=e.clientY;yaw+=dx*0.006;pitch+=dy*0.006;pitch=Math.max(-1.45,Math.min(1.45,pitch))});
canvas.addEventListener('pointerup',()=>dragging=false);
canvas.addEventListener('wheel',e=>{e.preventDefault();dist*=Math.exp(e.deltaY*0.001);dist=Math.max(700,Math.min(4500,dist))},{passive:false});

canvas.addEventListener('touchstart',e=>{
 if(e.touches.length===2) lastPinch=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
},{passive:false});
canvas.addEventListener('touchmove',e=>{
 if(e.touches.length===2){
   e.preventDefault();
   let p=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
   if(lastPinch){dist*=lastPinch/p;dist=Math.max(700,Math.min(4500,dist));}
   lastPinch=p;
 }
},{passive:false});

function resize(){
 const dpr=Math.min(devicePixelRatio||1,2);
 const w=Math.floor(innerWidth*dpr),h=Math.floor(innerHeight*dpr);
 if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;gl.viewport(0,0,w,h)}
}

gl.enable(gl.DEPTH_TEST);
gl.clearColor(0.027,0.043,0.094,1);

function frame(){
  resize();
  gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);

  const ex=dist*Math.cos(pitch)*Math.cos(yaw);
  const ey=dist*Math.cos(pitch)*Math.sin(yaw);
  const ez=dist*Math.sin(pitch);

  const P=perspective(46*Math.PI/180,canvas.width/canvas.height,10,10000);
  const V=lookAt([ex,ey,ez],[0,0,0],[0,0,1]);
  const MVP=mul(P,V);

  // Outline pass. Expand only for rendering; geometry placement stays unchanged.
  bindAttribs(outlineProg,outLoc);
  gl.enable(gl.CULL_FACE);
  gl.cullFace(gl.FRONT);
  gl.uniformMatrix4fv(outLoc.uMVP,false,new Float32Array(MVP));
  gl.uniform1f(outLoc.uExpand,4.8);
  gl.drawArrays(gl.TRIANGLES,0,POS.length/3);

  // Toon body pass.
  bindAttribs(toonProg,toonLoc);
  gl.cullFace(gl.BACK);
  gl.uniformMatrix4fv(toonLoc.uMVP,false,new Float32Array(MVP));
  gl.uniform1f(toonLoc.uExpand,0.0);
  gl.drawArrays(gl.TRIANGLES,0,POS.length/3);

  requestAnimationFrame(frame);
}
frame();
